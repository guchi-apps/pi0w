# --- SwitchBot CO2 センサー（複数台） ---
# 推奨: sensors.json.example を sensors.json にコピーして編集（install.sh でも自動作成）
# SWITCHBOT_SENSORS_FILE=sensors.json
#
# 1台だけの場合は従来どおり MAC + device_id でも可:
# SWITCHBOT_MAC=02:00:00:00:00:01
# MYROOM_DEVICE_ID=2

# MyRoom API（本番 URL は環境に合わせて変更）
MYROOM_API_URL=https://myroom.example.invalid/api/sensor

# --- 白くまくんアプリ (AirCloud Home) エアコン連携 ---
# 白くまくんアプリに登録したメールアドレスとパスワード
AIRCON_EMAIL=your@email.com
AIRCON_PASSWORD=your_password
# 複数台ある場合は名前または ID を指定（省略時は1台のみなら自動選択）
# AIRCON_UNIT_NAME=リビング
# AIRCON_UNIT_ID=12345
MYROOM_AIRCON_API_URL=https://myroom.example.invalid/api/aircon

# BLE スキャン待ち時間（秒）。センサーは約5分間隔でアドバタイズするため 90 推奨
SCAN_TIMEOUT=90
# 複数台時: 1台でも見つかったらあと何秒だけ他を待つか（見つかった分は送信する）
PARTIAL_SCAN_GRACE_SEC=20
# 1 にすると全台必須（未検出があれば失敗）。通常は 0 のまま
# REQUIRE_ALL_SENSORS=0
HTTP_TIMEOUT=30
# センサーごとの最終試行・最終成功を書くファイル（StatusHub のホスト一覧に出す。status-hub#581）。
# 既定は /var/lib/myroom-pi/sensor-status.tsv。空にすると書かない。--dry-run では書かない
# SENSOR_STATUS_FILE=/var/lib/myroom-pi/sensor-status.tsv

