# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- MyRoom 連携 ---
MYROOM_API_URL=https://myroom.example.invalid/api/latest
# 要確認: /api/latest はBearer認証必須（myroomアプリ側でのトークン発行方法を確認すること）
MYROOM_API_TOKEN=
MYROOM_DEVICE_ID=2
# この秒数以内にデータ取得できなければ myroom_freshness ソースはNG扱い
MYROOM_STALE_THRESHOLD_SEC=900
MYROOM_POLL_INTERVAL_SEC=60

# --- uptime-kuma 連携（認証不要のステータスページAPI） ---
# 例: https://kuma.example.com
UPTIME_KUMA_BASE_URL=
# ステータスページのslug
UPTIME_KUMA_SLUG=
UPTIME_KUMA_POLL_INTERVAL_SEC=60

# --- システム状態(CPU/メモリ/ディスク、ラズパイ本体のローカル計測) ---
SYSTEM_STATS_POLL_INTERVAL_SEC=5
# 使用率を見るディスクのマウントポイント
SYSTEM_STATS_DISK_PATH=/

# --- VPS状態連携（VPS本体のCPU/メモリ/ディスク、要Bearerトークン） ---
# VPS側 の vps-status-api.service が提供する内部API
VPS_STATUS_URL=https://vps.example.invalid/internal/vps-status
VPS_STATUS_TOKEN=
VPS_STATUS_POLL_INTERVAL_SEC=60

# --- AI利用枠連携（Claude 5時間/週間・Codex 週間の残り割合、要Bearerトークン） ---
# ops-dashboardの GET /api/ai-usage。トークンは読み取りAPI用(OPS_API_TOKEN)で、実値は非公開
AI_QUOTA_URL=https://ops.example.invalid/api/ai-usage
AI_QUOTA_TOKEN=
# 提供元の制限が厳しく、サーバー側も5分キャッシュのため短くしても意味がない
AI_QUOTA_POLL_INTERVAL_SEC=300

# --- LCD (I2C 16x2, PCF8574バックパック搭載品) ---
# i2cdetect -y 1 で実機確認（0x27 or 0x3F が多い）
LCD_I2C_ADDRESS=0x27
LCD_I2C_PORT=1
LCD_REFRESH_INTERVAL_SEC=2
DEFAULT_LCD_MODE=myroom

# --- LED (BCM番号、実配線に合わせて変更) ---
LED1_PIN=17
LED2_PIN=27
LED3_PIN=22
LED4_PIN=23
# 割当先は led_sources.py の LED_SOURCES キー（myroom_freshness / uptime_kuma_overall / heartbeat / always_on / always_off）
DEFAULT_LED1_SOURCE=myroom_freshness
DEFAULT_LED2_SOURCE=uptime_kuma_overall
DEFAULT_LED3_SOURCE=heartbeat
# led4は予備枠（Web UIから自由に割当変更可）
DEFAULT_LED4_SOURCE=always_off
HEARTBEAT_BLINK_INTERVAL_SEC=1
HEARTBEAT_STALL_THRESHOLD_SEC=5
# co2_alert / cpu_high_load ソースの閾値
CO2_ALERT_THRESHOLD=1000
CPU_ALERT_THRESHOLD_PERCENT=80

# --- 開発/検証用フォールバック ---
# 1でLCD/LEDを強制モック化（非Pi環境での開発用）
MOCK_HARDWARE=0
# 1でMyRoom/uptime-kuma取得をダミーデータに置換
FAKE_SOURCES=0
HTTP_TIMEOUT=10


